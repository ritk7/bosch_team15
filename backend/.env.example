# Copy this file to backend/.env and fill in what you have.
# Everything runs with nothing set: rules and classical ML decide, and Ask returns the best matching passage.

# Cloud models. One key enables both the small tier (Claude Haiku 5.5) and the large tier (Claude Sonnet 5.5).
ANTHROPIC_API_KEY=

# Local model through Ollama: free, private, works offline. Install from ollama.com, then: ollama pull qwen2.5:3b
# LOCAL_MODEL=qwen2.5:3b
# LOCAL_BASE_URL=http://localhost:11434/v1
# Count local inference at an amortised GPU cost instead of zero, if a judge asks (USD per million tokens):
# LOCAL_USD_IN=0
# LOCAL_USD_OUT=0

# Any tier can use an OpenAI-compatible provider instead (OpenAI, Groq, vLLM, LM Studio).
# Set the prices too, otherwise that tier's spend is counted as zero.
# SMALL_PROVIDER=openai
# SMALL_BASE_URL=https://api.openai.com/v1
# SMALL_MODEL=<model id>
# SMALL_API_KEY=
# SMALL_USD_IN=<USD per million input tokens>
# SMALL_USD_OUT=<USD per million output tokens>

# Rupees per US dollar for the ₹ figures. Set this to today's rate before the pitch.
USD_INR=88

# The tier the savings are measured against.
BASELINE_TIER=large
